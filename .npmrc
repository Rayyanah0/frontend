# Supply-chain policy — see SECURITY.md ("Dependency security").

# Only the public npm registry, only over HTTPS.
registry=https://registry.npmjs.org/

# Never run dependency install scripts implicitly. Packages that genuinely
# need them (native binaries) are allowlisted in package.json "lavamoat" and
# executed explicitly with `npm run setup` (@lavamoat/allow-scripts).
ignore-scripts=true

# Lockfile is the source of truth; `npm install` must not silently rewrite it
# in CI and new deps are pinned exactly.
package-lock=true
save-exact=true

# Refuse to install if engines don't match.
engine-strict=true

# Fail `npm audit` on high and critical findings.
audit-level=high

fund=false

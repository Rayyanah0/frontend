{
  "extends": "next/core-web-vitals",
  "rules": {
    "no-restricted-properties": [
      "error",
      {
        "object": "process",
        "property": "env",
        "message": "Read configuration through src/env.ts."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/env.ts", "next.config.js", "src/app/api/runtime-config/route.ts"],
      "rules": { "no-restricted-properties": "off" }
    }
  ]
}
